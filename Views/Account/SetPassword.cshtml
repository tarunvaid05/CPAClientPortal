@model JyotiIyerCPA.Models.SetPasswordViewModel
@{
    ViewData["Title"] = "Set Up Your Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .setup-card .form-control { border-radius: 8px; padding: 0.75rem 1rem; border: 2px solid #e9ecef; }
    .setup-card .form-control:focus { border-color: #dc3545; box-shadow: 0 0 0 0.2rem rgba(220,53,69,0.25); }
    .setup-card .input-group-text { background: #fff; border-right: 0; }
    .setup-card .input-group .form-control { border-left: 0; }
    .setup-card .btn-primary { background-color: #dc3545; border-color: #dc3545; border-radius: 8px; padding: 0.75rem 1.25rem; font-weight: 600; }
    .setup-card .btn-primary:hover { background-color: #b02a37; border-color: #b02a37; }
    .setup-card .helper { color: #6c757d; }
    .setup-logo { height: 60px; }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 setup-card">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <img src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/JILogo-rqoWNVzhAq7lz3IcopV4cnIyWDrb9V.png" alt="Jyoti Iyer CPA" class="setup-logo mb-3" />
                        <h3 class="mb-1">Welcome to Client Portal</h3>
                        <p class="text-muted">Complete your profile and set your password</p>
                    </div>

                    <form asp-action="SetPassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <input asp-for="FirstName" class="form-control" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <input asp-for="LastName" class="form-control" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            <div class="form-text helper">Optional, but helps us contact you quickly if needed.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input asp-for="Password" class="form-control" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <div class="form-text helper">At least 8 characters, include one uppercase and one special character.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Activate Account</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="text-center mt-3">
        <a class="text-muted" href="@Url.Action("ClientPortal", "Home")">Back to Login</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
