@{
    ViewData["Title"] = "About Us";
}

<!-- About Hero Section -->
<section class="about-hero py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="about-content">
                    <h1 class="display-4 fw-bold text-dark mb-4">Meet <span class="text-primary">Jyoti Iyer</span>, CPA</h1>
                    <p class="lead text-muted mb-4">
                        Welcome to my practice. I believe that great accounting goes beyond numbers -
                        it's about building relationships, understanding your unique situation, and
                        providing guidance you can trust.
                    </p>
                    <p class="lead text-muted">
                        Whether you're an individual looking for tax guidance or a business seeking
                        a dedicated financial partner, I'm here to help you navigate your financial
                        journey with confidence.
                    </p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-image text-center">
                    <img src="~/images/Logo.png" alt="Jyoti Iyer CPA" class="img-fluid about-logo" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Bio Section -->
<section class="bio-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h2 class="section-title text-center mb-5">My Story</h2>

                <div class="bio-content" style="font-size: 1.1rem; line-height: 1.8;">
                    <p class="text-muted mb-4">
                        With over 15 years of experience as a Certified Public Accountant, I have dedicated
                        my career to helping individuals and businesses achieve their financial goals through
                        thoughtful planning and expert guidance.
                    </p>

                    <p class="text-muted mb-4">
                        My journey in accounting began with a passion for problem-solving and a genuine desire
                        to help people make sense of their finances. After earning my CPA license and gaining
                        experience at respected firms, I founded this practice with a clear mission: to provide
                        the kind of personalized, attentive service that larger firms often can't offer.
                    </p>

                    <p class="text-muted mb-4">
                        I specialize in comprehensive tax compliance and planning, as well as bookkeeping, payroll,
                        and consulting services.
                    </p>

                    <p class="text-muted mb-0">
                        What sets my practice apart is the personal attention each client receives. When you
                        work with me, you're not just another account number. I'm committed to being accessible,
                        responsive, and proactive in helping you navigate tax seasons, business decisions, and
                        financial planning with confidence.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section bg-light text-dark" style="padding: 3rem 0 3.925rem;">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="section-title mb-5">Ready to Get Started?</h2>
                <p class="lead mb-4">
                    Contact us today for a consultation and see how we can help you achieve your financial goals.
                </p>
                <a href="@Url.Action("ContactUs")" class="btn btn-primary btn-lg">Get In Touch</a>
            </div>
        </div>
    </div>
</section>
