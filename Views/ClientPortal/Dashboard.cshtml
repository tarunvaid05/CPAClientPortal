@model JyotiIyerCPA.Models.ClientDashboardViewModel
@{
    ViewData["Title"] = "Client Dashboard";
    Layout = "~/Views/Shared/_ClientPortalLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4">Welcome, @Model.ClientName</h2>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white"><strong>Upload Documents</strong></div>
                <div class="card-body">
                    <form id="uploadForm" action="@Url.Action("Upload", "Documents")" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Choose file</label>
                            <input type="file" class="form-control" name="file" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Category (optional)</label>
                            <input type="text" class="form-control" name="category" placeholder="e.g., W2, 1099, K-1" />
                        </div>
                        <button type="submit" class="btn btn-primary">Upload</button>
                    </form>
                    <div id="uploadMsg" class="mt-3"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white"><strong>Your Recent Uploads</strong></div>
                <div class="card-body">
                    <div id="myUploads" class="small text-muted">Loading…</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function refreshUploads() {
            const res = await fetch('@Url.Action("List", "Documents")')
            const list = await res.json()
            const el = document.getElementById('myUploads')
            if (!Array.isArray(list) || list.length === 0) {
                el.textContent = 'No uploads yet.'
                return
            }
            el.innerHTML = list.map(d => `<div><i class="fas fa-file me-2"></i>${d.name} <span class="text-muted">(${Math.round((d.size||0)/1024)} KB) • ${new Date(d.uploadedAt).toLocaleString()}</span></div>`).join('')
        }

        document.getElementById('uploadForm').addEventListener('submit', async (e) => {
            e.preventDefault()
            const form = e.target
            const tokenMeta = document.querySelector('meta[name="request-verification-token"]')
            const token = tokenMeta ? tokenMeta.getAttribute('content') : ''
            const data = new FormData(form)
            const btn = form.querySelector('button[type="submit"]')
            const msg = document.getElementById('uploadMsg')
            btn.disabled = true
            msg.textContent = ''
            try {
                const res = await fetch(form.getAttribute('action'), { method: 'POST', body: data, headers: { 'RequestVerificationToken': token } })
                const out = await res.json()
                if (out.success) { msg.className = 'text-success'; msg.textContent = 'Uploaded.'; form.reset(); refreshUploads() }
                else { msg.className = 'text-danger'; msg.textContent = out.message || 'Upload failed.' }
            } catch { msg.className = 'text-danger'; msg.textContent = 'Upload failed.' }
            finally { btn.disabled = false }
        })

        refreshUploads()
    </script>
}

